FROM python:3.12-slim AS base
WORKDIR /app

# Install uv for fast dependency installs
RUN pip install uv
COPY pyproject.toml .
RUN uv pip install --system --no-cache .

COPY denialdesk/ ./denialdesk/
COPY alembic/ ./alembic/
COPY alembic.ini .

# Create data directories (prod: mount a volume or use S3)
RUN mkdir -p /app/data/uploads /app/data/statements

# Non-root user for least privilege
RUN useradd -m -u 1001 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

# Run migrations then start the server
CMD ["sh", "-c", "alembic upgrade head && uvicorn denialdesk.api.main:app --host 0.0.0.0 --port 8000 --no-access-log"]
