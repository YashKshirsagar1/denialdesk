# Copy this file and fill in real values via your secrets manager.
# NEVER commit a filled .env file to git.

# Database
POSTGRES_HOST=db
POSTGRES_DB=denialdesk
POSTGRES_USER=denialdesk
POSTGRES_PASSWORD=CHANGE_ME_USE_SECRETS_MANAGER

# Auth0 — configure after BAA is signed with Auth0
AUTH0_DOMAIN=CHANGE_ME.us.auth0.com
AUTH0_AUDIENCE=https://api.denialdesk.com
DEV_MODE=false

# LLM — BAA must be signed with Anthropic (Azure OpenAI alternate)
ANTHROPIC_API_KEY=CHANGE_ME_USE_SECRETS_MANAGER

# Backup
BACKUP_S3_BUCKET=denialdesk-backups-prod
BACKUP_ENCRYPTION_KEY=CHANGE_ME_USE_SECRETS_MANAGER

# AWS — use IAM instance profile / ECS task role, not static keys
# AWS_ACCESS_KEY_ID — do not set; use instance profile
# AWS_DEFAULT_REGION=us-east-1
